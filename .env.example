# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or Connect). Both are safe in the browser;
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Added in later steps (server-only, never NEXT_PUBLIC_):
# SUPABASE_SECRET_KEY=
# ANTHROPIC_API_KEY=
